  "state_machine": {
    "description": "Flat FSM driven by NPCCMD enum. One state at a time, no sub-states or phases.",
    "dispatcher": "KNpc::ProcStatus() — KNpc.cpp:609-673",
    "frame_counter": {
      "struct": "DOING_FRAME { nTotalFrame; nCurrentFrame; }",
      "tick_fn": "WaitForFrame() — increments nCurrentFrame, returns TRUE when >= nTotalFrame",
      "effect_fn": "IsReachFrame(percent) — returns TRUE when nCurrentFrame == nTotalFrame * percent / 100"
    },
    "states": {
      "do_none":        { "value": 0,  "handler": null,          "description": "No-op" },
      "do_stand":       { "value": 1,  "handler": "OnStand",     "description": "Idle/standing" },
      "do_walk":        { "value": 2,  "handler": "OnWalk",      "description": "Walking" },
      "do_run":         { "value": 3,  "handler": "OnRun",       "description": "Running" },
      "do_jump":        { "value": 4,  "handler": "OnJump",      "description": "Jumping (parabolic)" },
      "do_skill":       { "value": 5,  "handler": "OnSkill",     "description": "Skill startup (unused in dispatch, mapped to do_attack/do_magic)" },
      "do_magic":       { "value": 6,  "handler": "OnSkill",     "description": "Casting magic skill" },
      "do_attack":      { "value": 7,  "handler": "OnSkill",     "description": "Physical attack skill" },
      "do_sit":         { "value": 8,  "handler": "OnSit",       "description": "Sitting (regen)" },
      "do_hurt":        { "value": 9,  "handler": "OnHurt",      "description": "Hitstun" },
      "do_death":       { "value": 10, "handler": "OnDeath",     "description": "Death animation" },
      "do_defense":     { "value": 11, "handler": "OnDefense",   "description": "Blocking" },
      "do_idle":        { "value": 12, "handler": "OnIdle",      "description": "Idle (empty handler)" },
      "do_specialskill":{ "value": 13, "handler": null,          "description": "Special skill control (placeholder)" },
      "do_special1":    { "value": 14, "handler": "OnSpecial1",  "description": "Blur attack (Melee_AttackWithBlur)" },
      "do_special2":    { "value": 15, "handler": "OnSpecial2",  "description": "Thief skill action" },
      "do_special3":    { "value": 16, "handler": "OnSpecial3",  "description": "Empty" },
      "do_blurmove":    { "value": 17, "handler": "OnBlurMove",  "description": "Blur dash (Melee_MoveWithBlur)" },
      "do_runattack":   { "value": 18, "handler": "OnRunAttack", "description": "Charge attack (Melee_RunAndAttack)" },
