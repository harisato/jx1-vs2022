  "missing_concepts": {
    "hit_stop": {
      "exists": false,
      "note": "No freeze-frame on hit. Damage applied at 60% frame, animation continues uninterrupted."
    },
    "recovery_lock": {
      "exists": false,
      "note": "Actions end with immediate DoStand(). No recovery frames, no endlag, no commitment."
    },
    "combo_window": {
      "exists": false,
      "note": "No chain/cancel window. do_manyattack is a single skill with sub-steps, not player-driven combos. No input accepted during action frames."
    },
    "input_buffer": {
      "exists": false,
      "note": "No input queue. Commands are instant-or-drop. Client sends SendCommand(), server processes in current tick or ignores."
    },
    "sub_tick_phases": {
      "exists": false,
      "note": "Each game tick is atomic. Processing order: Activate() -> status effects -> ProcStatus(state handler) -> AI. No sub-division within a tick."
    },
    "cancel_interrupt": {
      "exists": false,
      "note": "No cancel mechanic. Once in do_attack/do_magic, must wait for WaitForFrame() to complete. Only external DoHurt() or DoDeath() can break out."
    }
  },

