  "action_frame_formulas": {
    "physical_attack": {
      "formula": "nTotalFrame = m_AttackFrame * MAX_PERCENT / (m_CurrentAttackSpeed + MAX_PERCENT)",
      "formula_expanded": "nTotalFrame = m_AttackFrame * 100 / (m_CurrentAttackSpeed + 100)",
      "post_process": "nTotalFrame -= nTotalFrame % 2 (round to even); clamp min 1",
      "effect_at_frame": "nCurrentFrame == nTotalFrame * 60 / 100 (ATTACKACTION_EFFECT_PERCENT=60)",
      "exit": "WaitForFrame() -> DoStand()",
      "source": "KNpc.cpp:2169-2173",
      "examples": {
        "base_atkspd_0":   { "AttackFrame": 20, "CurrentAttackSpeed": 0,   "result_frames": 20, "effect_frame": 12, "ms": 1111 },
        "atkspd_50":       { "AttackFrame": 20, "CurrentAttackSpeed": 50,  "result_frames": 12, "effect_frame": 7,  "ms": 667 },
        "atkspd_100":      { "AttackFrame": 20, "CurrentAttackSpeed": 100, "result_frames": 10, "effect_frame": 6,  "ms": 556 }
      }
    },
    "magic_cast": {
      "formula": "nTotalFrame = m_CastFrame * MAX_PERCENT / (m_CurrentCastSpeed + MAX_PERCENT)",
      "formula_expanded": "nTotalFrame = m_CastFrame * 100 / (m_CurrentCastSpeed + 100)",
      "post_process": "same as physical",
      "effect_at_frame": "same ATTACKACTION_EFFECT_PERCENT (60%)",
      "source": "KNpc.cpp:2189-2193"
    },
    "hurt_hitstun": {
      "formula_server": "nTotalFrame = m_HurtFrame * (MAX_PERCENT - m_CurrentHitRecover) / MAX_PERCENT",
      "formula_expanded": "nTotalFrame = m_HurtFrame * (100 - m_CurrentHitRecover) / 100",
      "skip_condition": "if m_CurrentHitRecover >= 100, hitstun is skipped entirely (immune)",
      "min_frames": 1,
      "exit": "WaitForFrame() -> DoStand() + m_ProcessAI = 1",
      "source": "KNpc.cpp:1427-1466",
      "examples": {
        "base":            { "HurtFrame": 12, "HitRecover": 0,   "result_frames": 12, "ms": 667 },
        "base_player":     { "HurtFrame": 12, "HitRecover": 6,   "result_frames": 11, "ms": 611 },
        "fast_recover_50": { "HurtFrame": 12, "HitRecover": 50,  "result_frames": 6,  "ms": 333 },
        "immune":          { "HurtFrame": 12, "HitRecover": 100, "result_frames": 0,  "ms": 0, "note": "returns immediately, no hurt state" }
      }
    },
    "run_movement": {
      "formula": "nTotalFrame = (m_RunFrame * m_RunSpeed) / m_CurrentRunSpeed",
      "note": "RunFrame is the cycle length, adjusted by speed ratio",
      "source": "KNpc.cpp:1778"
    },
    "blur_attack": {
      "formula": "nTotalFrame = m_AttackFrame * MAX_PERCENT / (m_CurrentAttackSpeed + MAX_PERCENT)",
      "state": "do_special1",
      "effect_at": "60% frame",
      "source": "KNpc.cpp:2286"
    },
    "jump_attack_phase1": {
      "state": "do_jumpattack",
      "step_0": "DoJump() — uses m_JumpFrame (40)",
      "step_1_formula": "nTotalFrame = m_AttackFrame * MAX_PERCENT / (MAX_PERCENT + m_CurrentAttackSpeed)",
      "effect_at": "60% of step_1 frames",
      "source": "KNpc.cpp:5715-5770"
    },
    "run_attack": {
      "state": "do_runattack",
      "step_0": "Run phase — nTotalFrame = m_RunSpeed, runs until m_nCurrentMeleeTime > MissleGenerateTime(0) or do_stand",
      "step_1": "Attack phase — nTotalFrame = 0 (instant effect at 60% check), then DoStand()",
      "source": "KNpc.cpp:5549-5713"
    },
    "many_attack": {
      "state": "do_manyattack",
      "formula": "nTotalFrame = pSkill->GetMissleGenerateTime(m_SpecialSkillStep)",
      "note": "Loops through ChildSkillNum iterations, each with its own frame duration from skill data",
      "effect_per_hit": "WaitForFrame() -> cast child skill -> DoManyAttack() next step",
      "source": "KNpc.cpp:5472-5547"
    }
  },

